APP_NAME=Restia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Replica set local de un nodo: scripts/mongo-local.ps1. Sin replica set no hay transacciones.
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs-restia
MONGODB_DATABASE=restia

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# En local por HTTP queda en false; detrás del proxy TLS (deploy/apache) ponlo en true. En producción siempre es true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# Clave HMAC de los refresh tokens (D-36). Vacía: se deriva de APP_KEY. Cambiarla cierra todas las sesiones Android.
RESTIA_REFRESH_KEY=

# Panel web (D-36, sección 6): orígenes que abren sesión por cookie y CSRF, y CORS con credenciales.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8443
RESTIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Transporte: detrás del proxy TLS local (deploy/apache), RESTIA_TRUSTED_PROXIES=127.0.0.1 y RESTIA_FORCE_HTTPS=true.
RESTIA_FORCE_HTTPS=false
RESTIA_TRUSTED_PROXIES=
RESTIA_HSTS_SECONDS=31536000

# PAC (F-1): simulated o sw. Credenciales del sandbox de SW Sapien; nunca se versionan.
RESTIA_PAC=simulated
SW_URL=https://services.test.sw.com.mx
SW_TOKEN=
SW_USER=
SW_PASSWORD=

# Asistentes del menú QR (QR-14) y del sitio público (SITE-3) con la API de Claude. Sin llave no se ofrecen.
ANTHROPIC_API_KEY=
RESTIA_ASSISTANT_MODEL=claude-haiku-5-5
