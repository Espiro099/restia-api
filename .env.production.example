# Plantilla de producción (Actividad 3.2). Copiar a .env en el servidor y llenar los secretos ahí;
# este archivo nunca lleva valores reales.
APP_NAME=Restia
APP_ENV=production
# Sin trazas ni detalles internos en las respuestas de error.
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.restia.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mongodb
MONGODB_URI=
MONGODB_DATABASE=restia

# Cookie de sesión: HttpOnly siempre, Secure, SameSite=Lax y contenido cifrado (AES-256-CBC).
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.restia.com

SANCTUM_STATEFUL_DOMAINS=admin.restia.com
RESTIA_CORS_ORIGINS=https://admin.restia.com

# Solo HTTPS (TLS 1.2/1.3 en el proxy) y HSTS de un año.
RESTIA_FORCE_HTTPS=true
RESTIA_TRUSTED_PROXIES=127.0.0.1
RESTIA_HSTS_SECONDS=31536000

BCRYPT_ROUNDS=12
RESTIA_REFRESH_KEY=

RESTIA_PAC=sw
SW_URL=https://services.sw.com.mx
SW_TOKEN=

# Asistente del sitio público (SITE-3) con la API de Claude. Sin llave no se ofrece.
ANTHROPIC_API_KEY=
RESTIA_ASSISTANT_MODEL=claude-haiku-5-5

# Inicio de sesión con Google (GOOGLE-1): ID de cliente OAuth Web de Google Cloud. Vacío, está apagado.
GOOGLE_CLIENT_ID=
